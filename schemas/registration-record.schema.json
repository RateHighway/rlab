{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Central .rlab registration record, policy 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordVersion", "pageId", "pageVersion", "profile", "standardVersion", "packagePath", "packageSha256", "sourcePath", "sourceSha256", "status", "allowedHosts", "registeredAt"],
  "properties": {
    "recordVersion": {"const": 1},
    "pageId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "pageVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "profile": {"enum": ["RLAB-PAGE-READONLY-0.2", "RLAB-DECLARATIVE-DESIGN-0.3"]},
    "standardVersion": {"enum": ["0.2", "0.3"]},
    "packagePath": {"type": "string", "pattern": "^packages/[a-f0-9]{64}\\.rlab$"},
    "packageSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourcePath": {"type": "string", "pattern": "^sources/[a-f0-9]{64}\\.zip$"},
    "sourceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["registered", "revoked"]},
    "allowedHosts": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
    "registeredAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
