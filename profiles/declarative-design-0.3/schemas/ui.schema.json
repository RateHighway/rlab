{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uiVersion",
    "title",
    "components"
  ],
  "properties": {
    "uiVersion": {
      "const": "0.3.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "components": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "Text"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "query",
              "columns"
            ],
            "properties": {
              "type": {
                "const": "DataTable"
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 60
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "label",
              "action"
            ],
            "properties": {
              "type": {
                "const": "ActionButton"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 60
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "label"
            ],
            "properties": {
              "type": {
                "const": "WorkflowButton"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
