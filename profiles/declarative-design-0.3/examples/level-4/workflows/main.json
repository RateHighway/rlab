{
  "workflowVersion": "0.3.0",
  "name": "Fleet review",
  "onFailure": "pause",
  "deadlineSeconds": 3600,
  "steps": [
    {
      "id": "read-fleet",
      "type": "query",
      "binding": "fleet",
      "dependsOn": []
    },
    {
      "id": "create-task",
      "type": "action",
      "binding": "create-task",
      "dependsOn": [
        "read-fleet"
      ]
    }
  ]
}
